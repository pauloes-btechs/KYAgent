# KYAgent example configuration — placeholders only. Copy to .env (git-ignored).
# Never commit real values. See docs/contracts/environment.md.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Storage (unset MONGODB_URI => in-memory store, dev/test only)
MONGODB_URI=
MONGODB_DB=kyagent

# Secrets — generate with npm run gen:signing-key / gen:pepper / gen:admin-key
KYA_SIGNING_PRIVATE_KEY=
# KYA_SIGNING_PRIVATE_KEY_FILE=/run/secrets/kya_signing_key
KYA_SIGNING_KEY_ID=
KYA_API_KEY_PEPPER=
# KYA_API_KEY_PEPPER_FILE=/run/secrets/kya_api_key_pepper
KYA_BOOTSTRAP_ADMIN_API_KEY=

KYA_ISSUER=kyagent
KYA_SIGNATURE_MAX_SKEW_SECONDS=300
KYA_CREDENTIAL_DEFAULT_TTL_SECONDS=900
KYA_CREDENTIAL_MAX_TTL_SECONDS=3600
KYA_MAX_BODY_BYTES=65536

# Mock/feature modes
SANCTIONS_MODE=mock
CHAIN_MODE=
LLM_MODE=
